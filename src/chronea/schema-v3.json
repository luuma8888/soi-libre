{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chronea:project:3",
  "title": "Chronéa project v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "createdAt",
    "updatedAt",
    "timelines",
    "timeSystems",
    "media",
    "sources",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "timelines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timeline"
      }
    },
    "timeSystems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": [
        "value",
        "precision",
        "qualifier"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "object"
            }
          ]
        },
        "precision": {
          "type": "string"
        },
        "qualifier": {
          "enum": [
            "exact",
            "approximate",
            "uncertain"
          ]
        },
        "notBefore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "object"
            }
          ]
        },
        "notAfter": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "object"
            }
          ]
        }
      }
    },
    "temporal": {
      "type": "object",
      "required": [
        "kind",
        "start",
        "end"
      ],
      "properties": {
        "kind": {
          "enum": [
            "point",
            "interval",
            "openInterval"
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/endpoint"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/endpoint"
            }
          ]
        },
        "displayLabel": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "temporal",
        "tags",
        "sourceIds",
        "mediaIds",
        "externalIds",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "displayDate": {
          "type": "string"
        },
        "laneId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "place": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mediaIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalIds": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "links": {
          "type": "string"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "sourceId",
        "targetId",
        "type",
        "direction"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "directed",
            "undirected"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lane": {
      "type": "object",
      "required": [
        "id",
        "name",
        "order",
        "visible"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "span": {
      "type": "object",
      "required": [
        "id",
        "title",
        "temporal"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "laneId": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": [
        "id",
        "title",
        "timeSystemId",
        "lanes",
        "spans",
        "events",
        "relations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "timeSystemId": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lane"
          }
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    "system": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "gregorian",
            "numeric",
            "customCalendar"
          ]
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "object"
        }
      }
    },
    "media": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mimeType",
        "size",
        "storageRef"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "storageRef": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "remoteUrl": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    }
  }
}
